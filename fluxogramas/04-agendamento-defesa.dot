digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.35, ranksep=0.32, bgcolor="transparent", fontname="Inter", pad=0.1];
  node  [fontname="Inter", fontsize=10, penwidth=1.3, margin="0.12,0.06"];
  edge  [fontname="Inter", fontsize=9, color="#6B7280", arrowsize=0.7, penwidth=1.1];
  i [shape=box, style="rounded,filled,bold", fillcolor="#2F6DB5", color="#2F6DB5", fontcolor="white", label=<Qualificação aprovada e 28<BR/>créditos em disciplinas>];
  e1 [shape=box, style="rounded,filled", fillcolor="#E9F6EE", color="#2E8B57", label=<<FONT POINT-SIZE="8" COLOR="#2E8B57"><B>ORIENTADOR(A)</B></FONT><BR/>Definir banca (mín. 3),<BR/>data, horário e local>];
  e2 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Preencher requerimento +<BR/>Anexo I (assinaturas do<BR/>aluno e do orientador)>];
  e3 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Depositar na Secretaria:<BR/>requerimento, 1 cópia do<BR/>trabalho, aceite do artigo,<BR/>parecer do CEP (se houver)>];
  d1 [shape=diamond, style=filled, fillcolor="#FFF4E0", color="#C27C0E", label=<Requisitos e documentos<BR/>conferidos?>, fontsize=9.5];
  e3b [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Complementar documentação>];
  e4 [shape=box, style="rounded,filled", fillcolor="#F3ECFA", color="#7B4FB0", label=<<FONT POINT-SIZE="8" COLOR="#7B4FB0"><B>COLEGIADO DO PPGMCS</B></FONT><BR/>Aprovar e designar a banca<BR/>(e decidir sessão fechada,<BR/>se houver)>];
  e5 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Enviar o trabalho aos<BR/>membros da banca>];
  e6 [shape=box, style="rounded,filled", fillcolor="#FDECEC", color="#B83A3A", label=<<FONT POINT-SIZE="8" COLOR="#B83A3A"><B>BANCA EXAMINADORA</B></FONT><BR/>Sessão pública de defesa>];
  d2 [shape=diamond, style=filled, fillcolor="#FDECEC", color="#B83A3A", label=<Aprovação unânime?>, fontsize=9.5];
  e8 [shape=box, style="rounded,filled", fillcolor="#F3ECFA", color="#7B4FB0", label=<<FONT POINT-SIZE="8" COLOR="#7B4FB0"><B>COLEGIADO DO PPGMCS</B></FONT><BR/>Pode conceder nova defesa<BR/>(até 6 meses; 60 dias se já<BR/>houve prorrogação)>];
  e7 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Entregar versão final,<BR/>versão eletrônica e termo de<BR/>divulgação (até 60 dias)>];
  e9 [shape=box, style="rounded,filled", fillcolor="#FFF4E0", color="#C27C0E", label=<<FONT POINT-SIZE="8" COLOR="#C27C0E"><B>SECRETARIA DO PPGMCS</B></FONT><BR/>Conferir quitação com a<BR/>Biblioteca e enviar<BR/>documentos à PRPG>];
  f1 [shape=box, style="rounded,filled,bold", fillcolor="#4A5565", color="#4A5565", fontcolor="white", label=<Diploma de Mestre expedido>];
  i -> e1;
  e1 -> e2;
  e2 -> e3;
  e3 -> d1;
  d1 -> e3b [xlabel=" Não ", fontcolor="#374151"];
  d1 -> e4 [xlabel=" Sim ", fontcolor="#374151"];
  e3b -> e3;
  e4 -> e5;
  e5 -> e6;
  e6 -> d2;
  d2 -> e7 [xlabel=" Sim ", fontcolor="#374151"];
  d2 -> e8 [xlabel=" Não ", fontcolor="#374151"];
  e8 -> e6;
  e7 -> e9;
  e9 -> f1;
}