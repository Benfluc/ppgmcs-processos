digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.35, ranksep=0.32, bgcolor="transparent", fontname="Inter", pad=0.1];
  node  [fontname="Inter", fontsize=10, penwidth=1.3, margin="0.12,0.06"];
  edge  [fontname="Inter", fontsize=9, color="#6B7280", arrowsize=0.7, penwidth=1.1];
  i [shape=box, style="rounded,filled,bold", fillcolor="#2F6DB5", color="#2F6DB5", fontcolor="white", label=<Discente com ≥ 12 créditos e<BR/>Seminários aprovada>];
  e1 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Elaborar relatório da<BR/>pesquisa>];
  e2 [shape=box, style="rounded,filled", fillcolor="#E9F6EE", color="#2E8B57", label=<<FONT POINT-SIZE="8" COLOR="#2E8B57"><B>ORIENTADOR(A)</B></FONT><BR/>Definir banca (3 doutores),<BR/>data, horário e local>];
  e3 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Preencher requerimento +<BR/>Anexo I e colher assinatura<BR/>do orientador>];
  e4 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Depositar requerimento e<BR/>relatório na Secretaria>];
  e5 [shape=box, style="rounded,filled", fillcolor="#FFF4E0", color="#C27C0E", label=<<FONT POINT-SIZE="8" COLOR="#C27C0E"><B>SECRETARIA DO PPGMCS</B></FONT><BR/>Protocolar e conferir<BR/>requisitos>];
  d1 [shape=diamond, style=filled, fillcolor="#FFF4E0", color="#C27C0E", label=<Documentação completa?>, fontsize=9.5];
  e5b [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Corrigir pendências e<BR/>reapresentar>];
  e6 [shape=box, style="rounded,filled", fillcolor="#F3ECFA", color="#7B4FB0", label=<<FONT POINT-SIZE="8" COLOR="#7B4FB0"><B>COLEGIADO DO PPGMCS</B></FONT><BR/>Aprovar comissão examinadora>];
  e7 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Enviar o relatório aos<BR/>membros da banca>];
  e8 [shape=box, style="rounded,filled", fillcolor="#FDECEC", color="#B83A3A", label=<<FONT POINT-SIZE="8" COLOR="#B83A3A"><B>BANCA EXAMINADORA</B></FONT><BR/>Sessão: seminário (até 40<BR/>min) + arguição (até 30 min<BR/>por examinador)>];
  d2 [shape=diamond, style=filled, fillcolor="#FDECEC", color="#B83A3A", label=<Aprovado(a)?>, fontsize=9.5];
  e9 [shape=box, style="rounded,filled", fillcolor="#FFF4E0", color="#C27C0E", label=<<FONT POINT-SIZE="8" COLOR="#C27C0E"><B>SECRETARIA DO PPGMCS</B></FONT><BR/>Registrar aprovação e lançar<BR/>4 créditos>];
  e10 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Realizar 2º exame em até 30<BR/>dias>];
  d3 [shape=diamond, style=filled, fillcolor="#FDECEC", color="#B83A3A", label=<Aprovado(a) no 2º exame?>, fontsize=9.5];
  f1 [shape=box, style="rounded,filled,bold", fillcolor="#2F6DB5", color="#2F6DB5", fontcolor="white", label=<Apto(a) a seguir para a<BR/>defesa>];
  f2 [shape=box, style="rounded,filled,bold", fillcolor="#7B4FB0", color="#7B4FB0", fontcolor="white", label=<Desligamento (Regulamento,<BR/>Art. 56, II)>];
  i -> e1;
  e1 -> e2;
  e2 -> e3;
  e3 -> e4;
  e4 -> e5;
  e5 -> d1;
  d1 -> e5b [xlabel=" Não ", fontcolor="#374151"];
  d1 -> e6 [xlabel=" Sim ", fontcolor="#374151"];
  e5b -> e4;
  e6 -> e7;
  e7 -> e8;
  e8 -> d2;
  d2 -> e9 [xlabel=" Sim ", fontcolor="#374151"];
  d2 -> e10 [xlabel=" Não ", fontcolor="#374151"];
  e9 -> f1;
  e10 -> d3;
  d3 -> e9 [xlabel=" Sim ", fontcolor="#374151"];
  d3 -> f2 [xlabel=" Não ", fontcolor="#374151"];
}