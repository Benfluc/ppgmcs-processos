digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.35, ranksep=0.32, bgcolor="transparent", fontname="Inter", pad=0.1];
  node  [fontname="Inter", fontsize=10, penwidth=1.3, margin="0.12,0.06"];
  edge  [fontname="Inter", fontsize=9, color="#6B7280", arrowsize=0.7, penwidth=1.1];
  i [shape=box, style="rounded,filled,bold", fillcolor="#2F6DB5", color="#2F6DB5", fontcolor="white", label=<Necessidade de interromper<BR/>atividades>];
  d0 [shape=diamond, style=filled, fillcolor="#E8F1FB", color="#2F6DB5", label=<Que tipo de trancamento?>, fontsize=9.5];
  e1 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Verificar se está no 1º<BR/>terço da carga horária e se<BR/>nunca trancou essa<BR/>disciplina>];
  e2 [shape=box, style="rounded,filled", fillcolor="#E9F6EE", color="#2E8B57", label=<<FONT POINT-SIZE="8" COLOR="#2E8B57"><B>ORIENTADOR(A)</B></FONT><BR/>Dar anuência ao pedido>];
  e3 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Protocolar pedido na<BR/>Secretaria>];
  e5 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Reunir justificativa e<BR/>comprovantes dos motivos<BR/>relevantes>];
  e6 [shape=box, style="rounded,filled", fillcolor="#E9F6EE", color="#2E8B57", label=<<FONT POINT-SIZE="8" COLOR="#2E8B57"><B>ORIENTADOR(A)</B></FONT><BR/>Dar anuência ao pedido>];
  e7 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Protocolar pedido na<BR/>Secretaria>];
  e4 [shape=box, style="rounded,filled", fillcolor="#FFF4E0", color="#C27C0E", label=<<FONT POINT-SIZE="8" COLOR="#C27C0E"><B>SECRETARIA DO PPGMCS</B></FONT><BR/>Conferir prazo, anuência e<BR/>histórico de trancamentos>];
  d1 [shape=diamond, style=filled, fillcolor="#F3ECFA", color="#7B4FB0", label=<Pedido deferido?>, fontsize=9.5];
  e8 [shape=box, style="rounded,filled", fillcolor="#FFF4E0", color="#C27C0E", label=<<FONT POINT-SIZE="8" COLOR="#C27C0E"><B>SECRETARIA DO PPGMCS</B></FONT><BR/>Registrar trancamento (total<BR/>suspende a contagem do<BR/>prazo)>];
  f1 [shape=box, style="rounded,filled,bold", fillcolor="#2F6DB5", color="#2F6DB5", fontcolor="white", label=<Trancamento registrado>];
  f2 [shape=box, style="rounded,filled,bold", fillcolor="#2F6DB5", color="#2F6DB5", fontcolor="white", label=<Matrícula mantida; cumprir<BR/>as atividades>];
  i -> d0;
  d0 -> e1 [xlabel=" Parcial ", fontcolor="#374151"];
  d0 -> e5 [xlabel=" Total ", fontcolor="#374151"];
  e1 -> e2;
  e2 -> e3;
  e3 -> e4;
  e5 -> e6;
  e6 -> e7;
  e7 -> e4;
  e4 -> d1;
  d1 -> e8 [xlabel=" Sim ", fontcolor="#374151"];
  d1 -> f2 [xlabel=" Não ", fontcolor="#374151"];
  e8 -> f1;
}