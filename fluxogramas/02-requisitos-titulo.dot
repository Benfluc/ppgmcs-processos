digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.35, ranksep=0.32, bgcolor="transparent", fontname="Inter", pad=0.1];
  node  [fontname="Inter", fontsize=10, penwidth=1.3, margin="0.12,0.06"];
  edge  [fontname="Inter", fontsize=9, color="#6B7280", arrowsize=0.7, penwidth=1.1];
  i [shape=box, style="rounded,filled,bold", fillcolor="#2F6DB5", color="#2F6DB5", fontcolor="white", label=<Matrícula como discente<BR/>regular (mês 1)>];
  e1 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Cursar disciplinas<BR/>obrigatórias e optativas<BR/>(renovar matrícula a cada<BR/>período)>];
  e2 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Cursar Seminários no 2º<BR/>semestre (pré-projeto)>];
  e3 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Qualificação aprovada até o<BR/>14º mês (+4 créditos)>];
  e4 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Completar 28 créditos em<BR/>disciplinas, incluindo<BR/>Créditos Especiais A>];
  e5 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Depositar a dissertação até<BR/>o 23º mês>];
  d1 [shape=diamond, style=filled, fillcolor="#FDECEC", color="#B83A3A", label=<Aprovação unânime da<BR/>banca?>, fontsize=9.5];
  e5b [shape=box, style="rounded,filled", fillcolor="#F3ECFA", color="#7B4FB0", label=<<FONT POINT-SIZE="8" COLOR="#7B4FB0"><B>COLEGIADO DO PPGMCS</B></FONT><BR/>Nova defesa em até 6 meses,<BR/>se proposta pela banca>];
  e6 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Entregar versão final em até<BR/>60 dias e quitação da<BR/>Biblioteca>];
  e7 [shape=box, style="rounded,filled", fillcolor="#FFF4E0", color="#C27C0E", label=<<FONT POINT-SIZE="8" COLOR="#C27C0E"><B>SECRETARIA DO PPGMCS</B></FONT><BR/>Conferir requisitos e enviar<BR/>documentos à PRPG>];
  f1 [shape=box, style="rounded,filled,bold", fillcolor="#4A5565", color="#4A5565", fontcolor="white", label=<Diploma expedido (PRPG) e<BR/>registrado (Secretaria<BR/>Geral)>];
  i -> e1;
  e1 -> e2;
  e2 -> e3;
  e3 -> e4;
  e4 -> e5;
  e5 -> d1;
  d1 -> e6 [xlabel=" Sim ", fontcolor="#374151"];
  d1 -> e5b [xlabel=" Não ", fontcolor="#374151"];
  e5b -> d1;
  e6 -> e7;
  e7 -> f1;
}