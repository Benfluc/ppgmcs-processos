digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.35, ranksep=0.32, bgcolor="transparent", fontname="Inter", pad=0.1];
  node  [fontname="Inter", fontsize=10, penwidth=1.3, margin="0.12,0.06"];
  edge  [fontname="Inter", fontsize=9, color="#6B7280", arrowsize=0.7, penwidth=1.1];
  i [shape=box, style="rounded,filled,bold", fillcolor="#2F6DB5", color="#2F6DB5", fontcolor="white", label=<Discente regular com<BR/>disciplina cursada fora do<BR/>currículo do PPGMCS>];
  e1 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Reunir histórico,<BR/>programa/ementa e carga<BR/>horária da disciplina>];
  e2 [shape=box, style="rounded,filled", fillcolor="#E9F6EE", color="#2E8B57", label=<<FONT POINT-SIZE="8" COLOR="#2E8B57"><B>ORIENTADOR(A)</B></FONT><BR/>Manifestar-se sobre a<BR/>pertinência ao plano de<BR/>estudos>];
  e3 [shape=box, style="rounded,filled", fillcolor="#E8F1FB", color="#2F6DB5", label=<<FONT POINT-SIZE="8" COLOR="#2F6DB5"><B>DISCENTE</B></FONT><BR/>Protocolar o pedido na<BR/>Secretaria>];
  e4 [shape=box, style="rounded,filled", fillcolor="#FFF4E0", color="#C27C0E", label=<<FONT POINT-SIZE="8" COLOR="#C27C0E"><B>SECRETARIA DO PPGMCS</B></FONT><BR/>Conferir documentos e<BR/>limites (16 créditos,<BR/>conceito B, 3 anos, 25%)>];
  d1 [shape=diamond, style=filled, fillcolor="#F3ECFA", color="#7B4FB0", label=<Aproveitamento deferido?>, fontsize=9.5];
  e5 [shape=box, style="rounded,filled", fillcolor="#FFF4E0", color="#C27C0E", label=<<FONT POINT-SIZE="8" COLOR="#C27C0E"><B>SECRETARIA DO PPGMCS</B></FONT><BR/>Registrar créditos<BR/>aproveitados no histórico>];
  f1 [shape=box, style="rounded,filled,bold", fillcolor="#2F6DB5", color="#2F6DB5", fontcolor="white", label=<Créditos aproveitados>];
  f2 [shape=box, style="rounded,filled,bold", fillcolor="#2F6DB5", color="#2F6DB5", fontcolor="white", label=<Cursar os créditos no PPGMCS>];
  i -> e1;
  e1 -> e2;
  e2 -> e3;
  e3 -> e4;
  e4 -> d1;
  d1 -> e5 [xlabel=" Sim (total ou parcial) ", fontcolor="#374151"];
  d1 -> f2 [xlabel=" Não ", fontcolor="#374151"];
  e5 -> f1;
}